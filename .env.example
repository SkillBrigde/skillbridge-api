# ==============================================================================
# SkillBridge API - File Mẫu Biến Môi Trường Cục Bộ (.env.example)
# Sao chép file này thành .env để sử dụng khi chạy Docker hoặc thiết lập cục bộ:
# cp .env.example .env
# ==============================================================================

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge
POSTGRES_PORT=5432

# Cấu hình Message Broker RabbitMQ
RABBITMQ_USER=skillbridge
RABBITMQ_PASS=skillbridge
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Cấu hình Bộ nhớ đệm Redis
REDIS_PORT=6379
RateLimiting__Login__PermitLimit=5
RateLimiting__Login__WindowSeconds=60

# Chuỗi kết nối dùng cho .NET (Bootstrapper API và các Modules)
ConnectionStrings__Database=Host=localhost;Port=5432;Database=skillbridge;Username=skillbridge;Password=skillbridge
RabbitMq__Host=localhost
RabbitMq__Username=skillbridge
RabbitMq__Password=skillbridge
Redis__ConnectionString=localhost:6379

# JWT: generate a unique random key for each environment (at least 32 UTF-8 bytes).
# Keep the real value only in .env or your deployment secret store.
Jwt__SecretKey=
# Jwt__Issuer=SkillBridge.Api
# Jwt__Audience=SkillBridge.Client

# Environment addresses and browser origins
# Production: use explicit deployed frontend origins for the Cors entries.
# Production: set AllowedHosts to explicit domain names separated by semicolons.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
AllowedHosts=*

MINIO_ROOT_USER=skillbridge
MINIO_ROOT_PASSWORD=skillbridgeadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Payments: disabled until merchant credentials and webhook are configured.
Payments__VnPay__Enabled=false
Payments__VnPay__TmnCode=
Payments__VnPay__HashSecret=
Payments__VnPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payments__PayOS__Enabled=false
Payments__PayOS__ClientId=
Payments__PayOS__ApiKey=
Payments__PayOS__ChecksumKey=
# Exact HTTPS return URLs, no wildcard. No automatic payout/refund switch exists.
# Payments__AllowedReturnUrls__0=https://web.example/checkout/result
# Payments__AllowedReturnUrls__1=https://web.example/checkout/cancel
